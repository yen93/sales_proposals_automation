# Google Cloud OAuth client (Gmail + Drive + Slides scopes enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated by oauth_setup.py after completing the consent flow once
GOOGLE_REFRESH_TOKEN=

# OpenAI API key (platform.openai.com) - used for OCR/vision, template
# selection, Fathom call matching, and slide text rewriting
OPENAI_API_KEY=
# Optional: override the model used for all of the above (default: gpt-5.6-luna)
OPENAI_MODEL=

# Supabase project used for the proposal_demo_notes_email_logs dedup table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Fathom (developers.fathom.ai) - used to enrich proposals with pricing/
# special-request notes from the matching demo-call recording, if any.
# Optional: the pipeline proceeds without enrichment if unset or no match found.
FATHOM_API_KEY=

# Optional overrides (defaults come from project_vars.txt / config.py)
GMAIL_TRIGGER_QUERY=has:attachment after:2026/07/19 subject:("attached image")
FALLBACK_TEMPLATE_ID=
FATHOM_LOOKBACK_DAYS=30
