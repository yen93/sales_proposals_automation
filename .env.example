# Google Cloud OAuth client (Gmail + Drive + Slides scopes enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Populated by oauth_setup.py after completing the consent flow once
GOOGLE_REFRESH_TOKEN=

# Anthropic API key (console.anthropic.com) - used for OCR/vision, template
# selection, and slide text rewriting
ANTHROPIC_API_KEY=

# Supabase project used for the proposal_demo_notes_email_logs dedup table
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional overrides (defaults come from project_vars.txt / config.py)
GMAIL_TRIGGER_QUERY=has:attachment after:2026/07/19 subject:("attached image")
FALLBACK_TEMPLATE_ID=
